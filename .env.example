JWT_SECRET_KEY=change-me-in-production

# MongoDB Atlas connection
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=map_backend

# Gmail SMTP
MAIL_ENABLED=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Show OTP in terminal if email fails (local testing)
DEV_LOG_OTP=true

# Backend public URL (used for uploaded file and attachment links)
BASE_URL=http://localhost:5000/

# Optional client-app URL for deep links in emails (password reset, lead detail).
# Leave empty when running the API without a separate web client.
# CLIENT_APP_URL=http://localhost:3000/

# Server runtime (used by run.py)
# Keep FLASK_DEBUG=false in production.
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
