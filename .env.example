JWT_SECRET_KEY=change-me-in-production

# MongoDB (optional override via config.cfg)
# MONGODB_DB=map_backend

# Email delivery — Gmail (local testing)
# Normal Gmail password does NOT work for SMTP. Use a Google App Password:
#   https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=your-gmail@gmail.com
DEV_LOG_OTP=true

# Production (Elastic Email) example:
# MAIL_SERVER=smtp.elasticemail.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
